<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport"
content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="theme-color" content="#050308">
<title>HOPE | Personal AI</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: #050308;
    color: #f5d9ff;
    font-family: Arial, sans-serif;
    height: 100vh;
    overflow: hidden;
}

.interface {
    height: 100vh;
    width: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    background:
      radial-gradient(ellipse at center,
      #260b27 0%, #100713 38%, #050308 75%);
}

.topbar {
    position: absolute;
    top: 45px;
    width: 100%;
    text-align: center;
    letter-spacing: 5px;
    font-size: 11px;
    color: #eaa5ff;
    opacity: .8;
}

.topbar span {
    color: #ff55db;
}

.hud {
    position: absolute;
    width: min(94vw, 520px);
    aspect-ratio: 1;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -53%);
}

svg {
    width: 100%;
    height: 100%;
    overflow: visible;
}

.ring {
    fill: none;
    stroke: #fa73ed;
    transform-origin: 250px 250px;
}

.r1 {
    stroke-width: 1.2;
    opacity: .9;
    stroke-dasharray: 4 5;
    animation: spin 35s linear infinite;
}

.r2 {
    stroke-width: 2;
    opacity: .7;
    stroke-dasharray: 100 12 4 12;
    animation: reverse 24s linear infinite;
}

.r3 {
    stroke-width: 1;
    opacity: .8;
    stroke-dasharray: 2 8;
    animation: spin 18s linear infinite;
}

.r4 {
    stroke-width: 3;
    opacity: .6;
    stroke-dasharray: 35 9 2 9;
    animation: reverse 15s linear infinite;
}

.r5 {
    stroke-width: 1;
    opacity: .65;
    animation: spin 60s linear infinite;
}

.orbit {
    fill: none;
    stroke: #ff79ed;
    stroke-width: 1.5;
    opacity: .8;
    transform-origin: 250px 250px;
}

.orbit1 {
    animation: orbit 12s linear infinite;
}

.orbit2 {
    animation: orbit 18s linear infinite reverse;
}

.orbit3 {
    animation: orbit 24s linear infinite;
}

.glow {
    filter: url(#glow);
}

.core {
    fill: #ff9df3;
    filter: url(#glow);
    animation: pulse 3s ease-in-out infinite;
}

.markings {
    fill: none;
    stroke: #ff9bed;
    stroke-width: 1.5;
    opacity: .8;
}

.particles {
    fill: #fff0ff;
    filter: url(#glow);
}

.scan {
    transform-origin: 250px 250px;
    animation: spin 5s linear infinite;
}

.hope {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: #fff3ff;
    font-size: clamp(38px, 12vw, 65px);
    font-weight: 200;
    letter-spacing: 13px;
    padding-left: 13px;
    text-shadow:
      0 0 8px #ff9cff,
      0 0 20px #ed48e4,
      0 0 45px #d72acb;
}

.subtitle {
    position: absolute;
    top: calc(50% + 48px);
    width: 100%;
    text-align: center;
    font-size: 9px;
    letter-spacing: 5px;
    color: #f3a8f0;
}

.bottom {
    position: absolute;
    bottom: 55px;
    width: 100%;
    text-align: center;
}

.status {
    font-size: 11px;
    letter-spacing: 4px;
    color: #ff8bea;
    margin-bottom: 12px;
}

.dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ff57df;
    box-shadow: 0 0 12px #ff57df;
    margin-right: 8px;
    animation: pulse 2s infinite;
}

.info {
    font-size: 9px;
    letter-spacing: 2px;
    color: #99718f;
    line-height: 2;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

@keyframes reverse {
    to { transform: rotate(-360deg); }
}

@keyframes orbit {
    0% { transform: rotate(0deg) scaleY(.35); }
    50% { transform: rotate(180deg) scaleY(.35); }
    100% { transform: rotate(360deg) scaleY(.35); }
}

@keyframes pulse {
    0%, 100% { opacity: .6; }
    50% { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: 30s !important;
    }
}
</style>
</head>

<body>

<div class="interface">

<div class="topbar">
    HOLOGRAPHIC SYSTEM <span>•</span> HOPE
</div>

<div class="hud">

<svg viewBox="0 0 500 500"
xmlns="http://www.w3.org/2000/svg">

<defs>
    <filter id="glow">
        <feGaussianBlur stdDeviation="4"
        result="blur"/>
        <feMerge>
            <feMergeNode in="blur"/>
            <feMergeNode in="SourceGraphic"/>
        </feMerge>
    </filter>

    <linearGradient id="beam">
        <stop offset="0%" stop-color="#ff3de1"
        stop-opacity="0"/>
        <stop offset="50%" stop-color="#ffbaff"
        stop-opacity=".9"/>
        <stop offset="100%" stop-color="#ff3de1"
        stop-opacity="0"/>
    </linearGradient>
</defs>

<!-- OUTER MECHANICAL RINGS -->

<circle class="ring r1" cx="250" cy="250" r="237"/>
<circle class="ring r2" cx="250" cy="250" r="225"/>
<circle class="ring r3" cx="250" cy="250" r="210"/>
<circle class="ring r4" cx="250" cy="250" r="195"/>
<circle class="ring r5" cx="250" cy="250" r="180"/>

<!-- INNER STRUCTURE -->

<circle class="ring r1" cx="250" cy="250" r="165"/>
<circle class="ring r2" cx="250" cy="250" r="150"/>
<circle class="ring r3" cx="250" cy="250" r="132"/>
<circle class="ring r4" cx="250" cy="250" r="115"/>

<!-- ORBITAL ELLIPSES -->

<ellipse class="orbit orbit1"
cx="250" cy="250" rx="235" ry="72"/>

<ellipse class="orbit orbit2"
cx="250" cy="250" rx="225" ry="85"/>

<ellipse class="orbit orbit3"
cx="250" cy="250" rx="190" ry="105"/>

<!-- RADIAL TECHNICAL MARKINGS -->

<g class="markings" id="ticks"></g>

<!-- SCANNING BEAM -->

<g class="scan glow">
    <path d="M250 250 L250 15"
    stroke="url(#beam)" stroke-width="5"
    opacity=".7"/>
</g>

<!-- CENTRAL MECHANISM -->

<circle cx="250" cy="250" r="88"
fill="none" stroke="#ff70e9"
stroke-width="1.5" opacity=".8"/>

<circle cx="250" cy="250" r="78"
fill="none" stroke="#f9b5f5"
stroke-width=".7"
stroke-dasharray="3 5"/>

<circle cx="250" cy="250" r="64"
fill="none" stroke="#ff69e9"
stroke-width="2"
stroke-dasharray="35 8 3 8"/>

<circle class="core"
cx="250" cy="250" r="4"/>

<!-- MOVING PARTICLES -->

<g class="particles">
    <circle cx="250" cy="13" r="2"/>
    <circle cx="420" cy="105" r="2"/>
    <circle cx="90" cy="120" r="1.5"/>
    <circle cx="430" cy="360" r="2"/>
    <circle cx="65" cy="350" r="2"/>
    <circle cx="250" cy="485" r="2"/>
    <circle cx="350" cy="50" r="1.5"/>
    <circle cx="145" cy="440" r="2"/>
    <circle cx="470" cy="250" r="1.5"/>
    <circle cx="30" cy="250" r="2"/>
</g>

</svg>

<div class="hope">HOPE</div>

<div class="subtitle">
    PERSONAL INTELLIGENCE
</div>

</div>

<div class="bottom">

<div class="status">
    <span class="dot"></span>
    VISUAL SYSTEM ONLINE
</div>

<div class="info">
    HOLOGRAPHIC DISPLAY INITIALISED<br>
    VOICE MODULE NOT YET CONNECTED
</div>

</div>

</div>

<script>
const ticks = document.getElementById("ticks");

for (let i = 0; i < 180; i++) {
    const angle = i * 2;
    const major = i % 5 === 0;
    const inner = major ? 218 : 224;
    const outer = 232;

    const a = angle * Math.PI / 180;

    const x1 = 250 + Math.cos(a) * inner;
    const y1 = 250 + Math.sin(a) * inner;
    const x2 = 250 + Math.cos(a) * outer;
    const y2 = 250 + Math.sin(a) * outer;

    const line = document.createElementNS(
        "http://www.w3.org/2000/svg", "line"
    );

    line.setAttribute("x1", x1);
    line.setAttribute("y1", y1);
    line.setAttribute("x2", x2);
    line.setAttribute("y2", y2);
    line.setAttribute("stroke-width", major ? 1.5 : .7);
    line.setAttribute("opacity", major ? .9 : .45);

    ticks.appendChild(line);
}
</script>

</body>
</html>